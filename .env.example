# ==========================================
# Twitter Sentiment Analysis Platform - Environment Configuration
# ==========================================

# --- API Backend Settings ---
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=super-secret-sentiment-key-change-in-production-min32chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
# Default to SQLite for local standalone run; Set PostgreSQL URI for production/Docker:
# DATABASE_URL=postgresql+psycopg2://sentiment_user:sentiment_pass@localhost:5432/sentiment_db
DATABASE_URL=sqlite:///./sentiment.db

# --- Redis & Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Twitter / X API v2 (Optional: falls back to built-in Mock Stream & CSV upload) ---
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# --- NLP Engine Configuration ---
# Options: hybrid, vader, transformer
NLP_ENGINE_MODE=hybrid
TRANSFORMER_MODEL_NAME=cardiffnlp/twitter-roberta-base-sentiment-latest
USE_CUDA=false

# --- Frontend Web Application ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/live-feed

# --- Mobile App ---
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_WS_URL=ws://localhost:8000/ws/live-feed
